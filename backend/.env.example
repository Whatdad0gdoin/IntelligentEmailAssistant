# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Auth (NFR-04) ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_IN=3600

# JSON object of email -> password hash.
# Generate an entry with: python -m backend.scripts.hash_password
AUTH_USERS={}

# --- LLM orchestrator (section 4.1) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_VERSION=2024-10-21
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=20

# --- Budget governance ---
MAX_REQUESTS_PER_SESSION=100
TOKEN_BUDGET_CHARS=12000

# --- Grounding (section 4.3) ---
CLASSIFY_CONFIDENCE_THRESHOLD=0.7

# --- Latency (NFR-01) ---
LATENCY_TARGET_SECONDS=5
METRICS_WINDOW=100

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Email source adapter ---
# "fixture" reads .eml files from EMAIL_FIXTURE_DIR. That directory stands in
# for a mail server; it is a source the app reads, never a place it writes.
# "gmail" reads a real Gmail inbox over the Gmail API (see below);
# "gmail_imap" reads it over IMAP with an app password instead.
EMAIL_SOURCE=fixture
# Defaults to backend/adapters/fixtures. Set only to point elsewhere.
EMAIL_FIXTURE_DIR=
# Where the local SMTP server (python -m backend.mailserver) delivers.
# Defaults to backend/mailbox, which is gitignored. Read alongside the
# fixtures, so a message you send yourself shows up next to the demo mailbox.
EMAIL_INBOX_DIR=
# Characters in the inbox list preview, cut from the cleaned body.
SNIPPET_CHARS=140

# --- Local SMTP receiver (backend/mailserver.py) ---
# 127.0.0.1 accepts mail only from this machine. 0.0.0.0 accepts it from other
# devices on the same network, which is how you send from a phone -- opt in,
# because this receiver has no authentication and no TLS by design.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_MAX_BYTES=5000000

# --- Gmail over the Gmail API (EMAIL_SOURCE=gmail, recommended) ---
# OAuth, read-only scope. No password is stored anywhere: connect once with
#     python -m backend.scripts.gmail_auth
# which writes a token to backend/secrets/ (gitignored). The README has the
# Google Cloud steps. While the Google app is in Testing, Google ends access
# after 7 days; the inbox says so, and the same command reconnects.
#
# Every message fetched is sent to the LLM provider for classification and
# summarisation, so point this at an account made for the project.
GMAIL_CLIENT_FILE=
GMAIL_TOKEN_FILE=

# Shared by both Gmail sources. Any label works: INBOX, or a label you apply by
# hand to limit what the app can see.
GMAIL_MAILBOX=INBOX
# Newest N messages per inbox load. Each one crosses the network and is
# classified if not already cached, so this is a demo-sized cap.
GMAIL_LIMIT=25
GMAIL_TIMEOUT=20

# --- Gmail over IMAP (EMAIL_SOURCE=gmail_imap, fallback) ---
# A 16-character Google app password, NOT the account password, generated at
# https://myaccount.google.com/apppasswords with 2-step verification on. It is
# full mailbox access in plaintext in this file, which is why the API source is
# preferred. Kept because it needs no Google Cloud project.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993

# --- Voice (FR-05) ---
# Below this, the UI shows the transcript back and asks the user to choose
# rather than dispatching an action (section 6.3).
INTENT_CONFIDENCE_THRESHOLD=0.6

# --- LLM endpoint ---
# Leave empty for api.openai.com. Set for Azure OpenAI or a local gateway;
# OPENAI_API_VERSION is only sent when this is set, because api.openai.com has
# no request-level version selector to send it to.
OPENAI_BASE_URL=
